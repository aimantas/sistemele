# Secrets. The "Deploy to Cloudflare" button asks for these; `npm run setup`
# copies them into .dev.vars for local development. Never commit real keys.

# Your email. It becomes the owner on first sign-in. Comma-separate several.
ADMIN_EMAILS=owner@example.com
# Resend API key (https://resend.com/api-keys) for sign-in links and other email. Locally, leave it empty: links print on screen and in the terminal.
RESEND_API_KEY=
