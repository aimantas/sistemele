// Cloudflare Worker configuration. One Worker serves the API, the MCP endpoint,
// the server-rendered public site and the dashboard SPA (static assets).
// Deploy with the "Deploy to Cloudflare" button in the README (it creates the
// D1 database and fills in its id), or run `npm run setup:cloudflare`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistemele",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker decides: public pages are server-rendered, /app/* gets the SPA
    // shell, unknown paths get a real 404. Hashed build files skip the Worker.
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/screenshots/*", "!/logos/*", "!/fonts/*", "!/favicon.svg"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistemele",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Sistemėlė",
    // Production defaults. Local development overrides these in .dev.vars.
    // Empty: the address the Worker is served from (workers.dev or your domain). Set it once you add a custom domain.
    "APP_URL": "",
    "APP_ENV": "production",
    // Resend's test sender delivers only to the email of your Resend account. Verify your domain in Resend, then use an address on it.
    "EMAIL_FROM": "Sistemėlė <onboarding@resend.dev>"
  },
  // Secrets (never commit; listed in .dev.vars.example, which the Deploy button asks for):
  //   npx wrangler secret put ADMIN_EMAILS     your email; it becomes the owner on first sign-in
  //   npx wrangler secret put RESEND_API_KEY   sends sign-in links and other email
  // Optional: TURNSTILE_SECRET_KEY for the public contact form.

  // The public demo at https://sistemele.aimantas.com (fictional data, reset every hour).
  // Deploy: `npm run deploy:demo` with CLOUDFLARE_ACCOUNT_ID set to the account that owns aimantas.com.
  // Set database_id to a separate demo D1 database before deploying.
  // Remove this block in your own project, or point it at your own demo domain. See docs/deployment.md.
  "env": {
    "demo": {
      "name": "sistemele-demo",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "sistemele.aimantas.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sistemele-demo",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_NAME": "Sistemėlė demo",
        "APP_URL": "https://sistemele.aimantas.com",
        "APP_ENV": "demo",
        "EMAIL_FROM": "Sistemėlė demo <demo@sistemele.invalid>",
        "ADMIN_EMAILS": "",
        "DEMO_MODE": "1",
        // The demo is also the package's landing page: let search engines index its public pages.
        "ALLOW_INDEXING": "1"
      },
      // Empties every table and reloads seed/*.sql at the top of each hour.
      "triggers": { "crons": ["0 * * * *"] }
    }
  }
}
